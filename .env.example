# 复用已存在的本地中间件；Compose 不创建或删除中间件。
MYSQL_USER=aicloud_backend
MYSQL_PASSWORD=请填写本地MySQL密码
REDIS_PASSWORD=
REDIS_DATABASE=12
NACOS_USERNAME=nacos
NACOS_PASSWORD=请填写已有Nacos密码
GATEWAY_PORT=18080
IOT_MQTT_PORT=1883
AICLOUD_INTERNAL_SECRET=请填写至少32位随机内部RPC凭据

# 外部服务稍后配置。短信/支付/AI 的账号和渠道也可通过管理端接口维护。
WECHAT_MP_APP_ID=local-disabled
WECHAT_MP_SECRET=local-disabled
WECHAT_MINI_APP_ID=local-disabled
WECHAT_MINI_SECRET=local-disabled
BPM_SMS_ENABLED=false
